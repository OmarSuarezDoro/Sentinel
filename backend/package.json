{
  "name": "@mssp/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "node dist/jobs/worker.js",
    "test": "node --import tsx --test tests/domain.test.ts tests/architecture.test.ts tests/middleware.test.ts src/modules/*/*.tests.ts src/integrations/*.tests.ts",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test:integration": "node --import tsx --test tests/integration.test.ts",
    "test:onboarding": "node --import tsx --test tests/onboarding.integration.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.1.0",
    "ipaddr.js": "2.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.5",
    "@types/node": "22.19.0",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
