POSTGRES_DB=mssp
POSTGRES_USER=mssp
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql://mssp:change-this-database-password@localhost:5432/mssp
PORT=4000
COOKIE_SECURE=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Administrador MSSP
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=llama3.2

# Adaptadores seleccionados al iniciar API y worker.
# summary: template | local-llm; mail: microsoft-graph | disabled
SUMMARY_ADAPTER=template
MAIL_ADAPTER=microsoft-graph

# Destino interno único. Sin un correo válido se bloquea cualquier envío.
INTERNAL_REPORT_EMAIL=omar.suarez@alturanetgroup.com

# Installation key: generated locally by npm run onboarding. Never expose publicly.
ONBOARDING_TOKEN=
